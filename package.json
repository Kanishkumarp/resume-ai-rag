{
  "name": "resume-ai-rag",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npm run dev:backend",
    "backend": "ts-node-dev --respawn --transpile-only backend/src/server.ts",
    "dev:backend": "npm run backend",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "bootstrap:resumes": "ts-node src/scripts/bootstrapResumes.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "frontend": "vite",
    "frontend:dev": "vite",
    "dev:frontend": "npm run frontend",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "axios": "^1.18.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "mongodb": "^6.21.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.82.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.20",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
