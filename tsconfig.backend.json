{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": [
    "backend/src/**/*.ts",
    "scripts/backend/**/*.ts",
    "src/config/**/*.ts",
    "src/ingestion/**/*.ts",
    "src/middleware/**/*.ts",
    "src/repositories/**/*.ts",
    "src/routes/**/*.ts",
    "src/services/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "src/config/api.config.ts", "backend/src/config/api.config.ts", "dist", "node_modules"]
}
